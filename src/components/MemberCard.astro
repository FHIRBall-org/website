---
interface OrgLogo {
  name: string;
  logo: string;
  url: string;
  cardBadge: boolean;
}

interface Props {
  name: string;
  logo?: string;
  slug: string;
  description: string;
  content?: string;
  orgLogos?: OrgLogo[];
}

const { name, logo, slug, description, content, orgLogos = [] } = Astro.props;
---

<article class="bg-white border border-border rounded-lg p-6 hover:shadow-md transition-shadow">
  <div class="flex items-start gap-4">
    {logo ? (
      <img
        src={logo}
        alt={`${name} logo`}
        class="w-16 h-16 object-contain"
      />
    ) : (
      <div class="w-16 h-16 bg-surface rounded flex items-center justify-center text-text-light text-xs">
        Logo
      </div>
    )}
    <div class="flex-1">
      <a href={`/members/${slug}`} class="hover:text-primary transition-colors">
        <h3 class="text-lg font-semibold text-text">{name}</h3>
      </a>
      <p class="mt-1 text-sm text-text-light">{description}</p>
      {content && (
        <div class="mt-3 text-sm text-text-light prose prose-sm">
          <Fragment set:html={content} />
        </div>
      )}
      <a
        href={`/members/${slug}`}
        class="inline-block mt-3 text-sm text-primary hover:text-primary-hover font-medium"
      >
        View Profile &rarr;
      </a>
    </div>
  </div>
  {orgLogos.length > 0 && (
    <div class="member-org-logos mt-4 pt-3 border-t border-border flex flex-wrap gap-2">
      {orgLogos.map((org) => (
        <a
          href={org.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 bg-white border border-border rounded px-2 py-1 text-xs font-semibold shadow-sm hover:shadow-md transition-shadow"
        >
          <img src={org.logo} alt={org.name} class="h-4 w-auto object-contain" />
          <span>{org.name}</span>
        </a>
      ))}
    </div>
  )}
</article>
